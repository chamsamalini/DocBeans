# Supabase account service (required for sign-in)
DOCBEANS_AUTH_PROVIDER=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Comma-separated, case-insensitive administrator email allowlist.
# Administrators must also complete authenticator MFA.
DOCBEANS_ADMIN_EMAILS=admin@yourcompany.com

# Managed document-generation keys (optional when all users use BYOK)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Reserved for a future Auth0 adapter. Keep provider-specific values inside
# services/auth; frontend and backend modules must not read these directly.
# AUTH0_ISSUER_BASE_URL=https://your-tenant.auth0.com
# AUTH0_CLIENT_ID=
